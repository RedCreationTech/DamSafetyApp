[Tests]
  [elastic_hw_constructs]
    type = RunApp
    input = elastic.i
    cli_args = '--check-input'
    requirement = 'The explicitly acknowledged isotropic spatial-HW elastic research material shall construct with Hughes-Winget kinematics.'
  []
  [elastic_hw_runs]
    type = RunApp
    input = elastic.i
    requirement = 'The isolated elastic-only research material shall run a prescribed plane-strain extension path.'
  []
  [research_opt_in_required]
    type = RunException
    input = elastic.i
    cli_args = '--check-input Materials/stress/acknowledge_research_limits=false'
    expect_err = 'This elastic-only diagnostic is not a production material'
    requirement = 'The spatial-HW elastic research material shall require explicit acknowledgement of its limitations.'
  []
  [varying_stiffness_rejected]
    type = RunException
    input = elastic.i
    cli_args = 'Materials/elasticity/elasticity_tensor_prefactor=varying_stiffness'
    expect_err = 'requires time-constant elasticity'
    requirement = 'The elastic diagnostic shall reject time-varying elasticity.'
  []
  [extra_stress_rejected]
    type = RunException
    input = extra_stress.i
    expect_err = 'does not support extra_stress'
    requirement = 'The elastic diagnostic shall reject extra stress to prevent state accumulation.'
  []
  [extra_stress_provider_first_rejected]
    type = RunException
    input = extra_stress_provider_first.i
    expect_err = 'does not support extra_stress'
    requirement = 'The diagnostic rejects nonzero extra stress when its provider sorts before the stress material.'
  []
  [extra_stress_stress_first_rejected]
    type = RunException
    input = extra_stress_stress_first.i
    expect_err = 'does not support extra_stress'
    requirement = 'The diagnostic rejects nonzero extra stress when its provider sorts after the stress material.'
  []
[]
