[Tests]
  design = 'DES-CDPC-009'
  issues = '#TASK-CDPC-009C'
  [single_hex8_tension]
    type = RunApp
    input = single_hex8_tension.i
    requirement = 'DamSafetyApp shall solve a one-element tensile problem with the table-driven Abaqus-CDP-compatible stress update and expose constitutive state as finite-element outputs.'
  []
  [single_hex8_compression]
    type = RunApp
    input = single_hex8_compression.i
    requirement = 'DamSafetyApp shall solve a one-element monotonic compression diagnostic with the table-driven Abaqus-CDP-compatible stress update.'
  []
  [single_hex8_compression_cycle]
    type = RunApp
    input = single_hex8_compression_cycle.i
    requirement = 'DamSafetyApp shall preserve accepted constitutive history through compression unloading and reloading.'
  []
  [single_hex8_tension_compression]
    type = RunApp
    input = single_hex8_tension_compression.i
    requirement = 'DamSafetyApp shall solve a one-element tension-to-compression reversal diagnostic.'
  []
  [single_hex8_compression_tension]
    type = RunApp
    input = single_hex8_compression_tension.i
    requirement = 'DamSafetyApp shall solve a one-element compression-to-tension reversal diagnostic.'
  []
  [single_hex8_biaxial_compression]
    type = RunApp
    input = single_hex8_biaxial_compression.i
    requirement = 'DamSafetyApp shall solve a one-element biaxial compression diagnostic using the CDP meridian parameters.'
  []
  [single_hex8_shear]
    type = RunApp
    input = single_hex8_shear.i
    requirement = 'DamSafetyApp shall solve a one-element shear diagnostic with the non-associated CDP flow potential.'
  []
  [scalar_damage_viscosity_tension]
    type = RunApp
    input = single_hex8_tension.i
    cli_args = 'Materials/cdp/use_scalar_damage_viscosity=true Outputs/file_base=scalar_damage_viscosity_tension_out'
    requirement = 'The opt-in combined scalar damage viscosity candidate shall solve the tensile material path.'
  []
  [scalar_damage_viscosity_compression]
    type = RunApp
    input = single_hex8_compression.i
    cli_args = 'Materials/cdp/use_scalar_damage_viscosity=true Outputs/file_base=scalar_damage_viscosity_compression_out'
    requirement = 'The opt-in combined scalar damage viscosity candidate shall solve the compressive material path.'
  []
  [scalar_damage_viscosity_mixed]
    type = RunApp
    input = single_hex8_shear.i
    cli_args = 'Materials/cdp/use_scalar_damage_viscosity=true Outputs/file_base=scalar_damage_viscosity_mixed_out'
    requirement = 'The opt-in combined scalar damage viscosity candidate shall solve a mixed principal-stress path.'
  []
[]
