  [reject_unacknowledged]
    type = RunException
    input = cdp-new-5ms.i
    cli_args = 'Physics/SolidMechanics/CDPVelocityDynamic/all/diagnostic_3d_model=false'
    expect_err = 'requires acknowledged'
    requirement = 'Unsupported diagnostic settings fail instead of silently changing the intended damping formula.'
  []
  [reject_finite_strain]
    type = RunException
    input = cdp-new-5ms.i
    cli_args = 'Physics/SolidMechanics/CDPVelocityDynamic/all/strain=FINITE'
    expect_err = 'requires acknowledged'
    requirement = 'Unsupported diagnostic settings fail instead of silently changing the intended damping formula.'
  []
  [reject_bbar]
    type = RunException
